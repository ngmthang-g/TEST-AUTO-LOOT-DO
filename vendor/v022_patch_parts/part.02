eat = 1;
+        tradeSequence_.push_back(step);
+        SaveTradeSequence();
+        RefreshTradeSequenceList();
+        const int row = static_cast<int>(tradeSequence_.size()) - 1;
+        ListView_SetItemState(tradeSeqList_, row, LVIS_SELECTED | LVIS_FOCUSED, LVIS_SELECTED | LVIS_FOCUSED);
+        ListView_EnsureVisible(tradeSeqList_, row, FALSE);
+        LoadTradeSequenceRowToEditor(row);
+    }
+
+    void DeleteTradeSequenceRow() {
+        const int row = SelectedTradeSequenceIndex();
+        if (row < 0 || row >= static_cast<int>(tradeSequence_.size())) return;
+        tradeSequence_.erase(tradeSequence_.begin() + row);
+        SaveTradeSequence();
+        RefreshTradeSequenceList();
+        if (!tradeSequence_.empty()) {
+            const int next = std::min(row, static_cast<int>(tradeSequence_.size()) - 1);
+            ListView_SetItemState(tradeSeqList_, next, LVIS_SELECTED | LVIS_FOCUSED, LVIS_SELECTED | LVIS_FOCUSED);
+            LoadTradeSequenceRowToEditor(next);
+        }
+    }
+
+    void MoveTradeSequenceRow(int delta) {
+        const int row = SelectedTradeSequenceIndex();
+        if (row < 0) return;
+        const int next = row + delta;
+        if (next < 0 || next >= static_cast<int>(tradeSequence_.size())) return;
+        std::swap(tradeSequence_[static_cast<std::size_t>(row)], tradeSequence_[static_cast<std::size_t>(next)]);
+        SaveTradeSequence();
+        RefreshTradeSequenceList();
+        ListView_SetItemState(tradeSeqList_, next, LVIS_SELECTED | LVIS_FOCUSED, LVIS_SELECTED | LVIS_FOCUSED);
+        ListView_EnsureVisible(tradeSeqList_, next, FALSE);
+        LoadTradeSequenceRowToEditor(next);
+    }
+
+    void SaveTradeSequenceRowFromEditor() {
+        const int row = SelectedTradeSequenceIndex();
+        if (row < 0 || row >= static_cast<int>(tradeSequence_.size())) return;
+        TradeSequenceStep& step = tradeSequence_[static_cast<std::size_t>(row)];
+        LRESULT target = SendMessageW(tradeSeqTarget_, CB_GETCURSEL, 0, 0);
+        LRESULT kind = SendMessageW(tradeSeqKind_, CB_GETCURSEL, 0, 0);
+        step.target = target == 1 ? 1 : 0;
+        step.kind = kind == 1 ? 1 : 0;
+        if (step.kind == 1) step.target = 1;
+        step.description = GetText(tradeSeqDesc_);
+        step.delayMs = std::clamp(_wtoi(GetText(tradeSeqDelay_).c_str()), 50, 60000);
+        step.repeat = std::clamp(_wtoi(GetText(tradeSeqRepeat_).c_str()), 1, 999);
+        SaveTradeSequence();
+        RefreshTradeSequenceList();
+        ListView_SetItemState(tradeSeqList_, row, LVIS_SELECTED | LVIS_FOCUSED, LVIS_SELECTED | LVIS_FOCUSED);
+        LoadTradeSequenceRowToEditor(row);
+    }
+
+    void BeginTradeSequenceCapture() {
+        const int row = SelectedTradeSequenceIndex();
+        if (row < 0 || row >= static_cast<int>(tradeSequence_.size())) {
+            Log(L"Chuỗi GD: chưa chọn dòng để lấy tọa độ."); return;
+        }
+        SaveTradeSequenceRowFromEditor();
+        TradeSequenceStep& step = tradeSequence_[static_cast<std::size_t>(row)];
+        Account* target = TradeSequenceTargetAccount(step);
+        if (!target) {
+            Log(L"Chuỗi GD: thiếu acc đích để lấy tọa độ (MAIN hoặc CON)."); return;
+        }
+        captureSlot_ = ClickSlot::None;
+        captureMacroIndex_ = -1;
+        captureTradeSelectChildPid_ = 0;
+        captureTradeSequenceIndex_ = row;
+        capturePid_ = target->game.pid;
+        LogAccount(*target, L"Chuỗi GD dòng " + std::to_wstring(row + 1) + L": đưa chuột vào nút rồi nhấn F8.");
+    }
+
+    void TestTradeSequenceRow() {
+        const int row = SelectedTradeSequenceIndex();
+        if (row < 0 || row >= static_cast<int>(tradeSequence_.size())) return;
+        SaveTradeSequenceRowFromEditor();
+        TradeSequenceStep& step = tradeSequence_[static_cast<std::size_t>(row)];
+        Account* target = TradeSequenceTargetAccount(step);
+        if (!target || !step.point.valid) { Log(L"TEST chuỗi GD: thiếu acc đích hoặc tọa độ."); return; }
+        POINT point{}; std::wstring error;
+        if (!ScaleClickPoint(target->game, step.point, point, error) || !RealInputClick(*target, point, error)) {
+            LogAccount(*target, L"TEST chuỗi GD FAIL: " + error); return;
+        }
+        LogAccount(*target, L"TEST chuỗi GD dòng " + std::to_wstring(row + 1) + L" PASS • REAL INPUT chiếm chuột.");
+    }
+
