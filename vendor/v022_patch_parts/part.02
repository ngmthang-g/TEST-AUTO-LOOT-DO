+
+        MakeIn(parent, L"STATIC", L"ACC:", 0, 15, 287, 38, 22, 0);
+        tradeSeqTarget_ = MakeIn(parent, WC_COMBOBOXW, L"", CBS_DROPDOWNLIST, 55, 282, 105, 150, IDC_SEQ_TARGET);
+        SendMessageW(tradeSeqTarget_, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(L"MAIN"));
+        SendMessageW(tradeSeqTarget_, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(L"CON đang chọn"));
+        SendMessageW(tradeSeqTarget_, CB_SETCURSEL, 0, 0);
+        MakeIn(parent, L"STATIC", L"Loại:", 0, 170, 287, 40, 22, 0);
+        tradeSeqKind_ = MakeIn(parent, WC_COMBOBOXW, L"", CBS_DROPDOWNLIST, 212, 282, 120, 150, IDC_SEQ_KIND);
+        SendMessageW(tradeSeqKind_, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(L"CLICK"));
+        SendMessageW(tradeSeqKind_, CB_ADDSTRING, 0, reinterpret_cast<LPARAM>(L"CHUYỂN ĐỒ"));
+        SendMessageW(tradeSeqKind_, CB_SETCURSEL, 0, 0);
+        MakeIn(parent, L"STATIC", L"Mô tả:", 0, 342, 287, 50, 22, 0);
+        tradeSeqDesc_ = MakeIn(parent, L"EDIT", L"", WS_BORDER | ES_AUTOHSCROLL, 394, 282, 250, 27, IDC_SEQ_DESC);
+        MakeIn(parent, L"STATIC", L"Delay ms:", 0, 652, 287, 62, 22, 0);
+        tradeSeqDelay_ = MakeIn(parent, L"EDIT", L"500", WS_BORDER | ES_NUMBER | ES_CENTER, 716, 282, 62, 27, IDC_SEQ_DELAY);
+        MakeIn(parent, L"STATIC", L"Lặp:", 0, 786, 287, 34, 22, 0);
+        tradeSeqRepeat_ = MakeIn(parent, L"EDIT", L"1", WS_BORDER | ES_NUMBER | ES_CENTER, 822, 282, 43, 27, IDC_SEQ_REPEAT);
+
+        MakeIn(parent, L"BUTTON", L"+ THÊM", BS_PUSHBUTTON, 15, 323, 90, 30, IDC_SEQ_ADD);
+        MakeIn(parent, L"BUTTON", L"- XÓA", BS_PUSHBUTTON, 112, 323, 80, 30, IDC_SEQ_DELETE);
+        MakeIn(parent, L"BUTTON", L"LÊN", BS_PUSHBUTTON, 199, 323, 70, 30, IDC_SEQ_UP);
+        MakeIn(parent, L"BUTTON", L"XUỐNG", BS_PUSHBUTTON, 276, 323, 75, 30, IDC_SEQ_DOWN);
+        MakeIn(parent, L"BUTTON", L"LƯU DÒNG", BS_PUSHBUTTON, 360, 323, 105, 30, IDC_SEQ_SAVE);
+        MakeIn(parent, L"BUTTON", L"LẤY TỌA (F8)", BS_PUSHBUTTON, 474, 323, 125, 30, IDC_SEQ_CAPTURE);
+        MakeIn(parent, L"BUTTON", L"TEST DÒNG", BS_PUSHBUTTON, 608, 323, 105, 30, IDC_SEQ_TEST);
+        MakeIn(parent, L"BUTTON", L"ĐÓNG", BS_PUSHBUTTON, 775, 323, 90, 30, IDC_SEQ_CLOSE);
+        MakeIn(parent, L"STATIC", L"CHUYỂN ĐỒ luôn chạy trên CON và tự giới hạn số click theo số ô trống còn lại của MAIN.", 0, 15, 365, 850, 23, 0);
