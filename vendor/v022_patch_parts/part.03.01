+    int EffectiveTradeStepRepeat(const TradeSequenceStep& step, const Account& main) const {
+        int repeat = std::max(1, step.repeat);
+        if (step.kind == 1) {
+            const int capByMain = std::max(0, main.snapshot.freeBagSpace - mainSellThreshold_);
+            repeat = std::min(repeat, std::min(maxTransferClicks_, capByMain));
+        }
+        return repeat;
+    }
+
+    bool ExecuteTradeSequenceTick(Account& main, Account& child, DWORD now) {
+        if (tradeTxn_.sequenceIndex >= tradeSequence_.size()) {
+            FinishTrade(now); return true;
+        }
+        if (tradeTxn_.sequenceDueTick != 0 && static_cast<LONG>(now - tradeTxn_.sequenceDueTick) < 0) return true;
+        TradeSequenceStep& step = tradeSequence_[tradeTxn_.sequenceIndex];
+        const int effectiveRepeat = EffectiveTradeStepRepeat(step, main);
+        if (step.kind == 1 && effectiveRepeat <= 0) {
+            AbortTrade(L"MAIN không còn sức chứa an toàn cho bước CHUYỂN ĐỒ", now); return false;
+        }
+        Account& target = step.target == 0 ? main : child;
+        if (!IsWindow(target.game.window)) { AbortTrade(L"mất cửa sổ đích ở chuỗi click", now); return false; }
+        POINT point{}; std::wstring error;
+        if (!ScaleClickPoint(target.game, step.point, point, error)) {
+            AbortTrade(L"bước " + std::to_wstring(tradeTxn_.sequenceIndex + 1) + L" sai tọa: " + error, now); return false;
+        }
+        const std::wstring targetLabel = step.target == 0 ? L"MAIN" : L"CON" + std::to_wstring(tradeTxn_.childSlot);
+        const std::wstring desc = step.description.empty() ? TradeStepKindLabel(step) : step.description;
+        SetTradeStatus(L"MAIN ↔ CON" + std::to_wstring(tradeTxn_.childSlot) + L" • bước " +
+                       std::to_wstring(tradeTxn_.sequenceIndex + 1) + L"/" + std::to_wstring(tradeSequence_.size()) +
+                       L" • chuột → " + targetLabel + L" • " + desc + L" (" +
+                       std::to_wstring(tradeTxn_.sequenceRepeatDone + 1) + L"/" + std::to_wstring(effectiveRepeat) + L")");
+        target.runtime.status = L"ĐIỀU PHỐI CHUỘT • " + desc;
+        if (!RealInputClick(target, point, error)) {
+            AbortTrade(L"REAL INPUT bước " + std::to_wstring(tradeTxn_.sequenceIndex + 1) + L" FAIL: " + error, now); return false;
+        }
+        ++tradeTxn_.sequenceRepeatDone;
+        tradeTxn_.sequenceDueTick = GetTickCount() + static_cast<DWORD>(step.delayMs);
+        if (tradeTxn_.sequenceRepeatDone >= effectiveRepeat) {
+            tradeTxn_.sequenceRepeatDone = 0;
+            ++tradeTxn_.sequenceIndex;
+        }
+        return true;
+    }
